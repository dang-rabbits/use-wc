{
  "name": "use-wc",
  "version": "0.0.0-semantic-release",
  "private": false,
  "homepage": "https://usewc.com",
  "bugs": "https://github.com/dang-rabbits/use-wc/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dang-rabbits/use-wc"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json",
    "AI.md"
  ],
  "type": "module",
  "types": "./dist/use-wc.d.ts",
  "exports": {
    ".": "./dist/use-wc.mjs",
    "./i18n": {
      "types": "./dist/i18n.d.mts",
      "default": "./dist/i18n.mjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./design-system.css": "./dist/design-system.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "pack": "vp run generate-strings && tsc && vp run analyze && vp pack && vp run generate-docs",
    "preview": "vp preview",
    "analyze": "custom-elements-manifest analyze",
    "generate-docs": "node scripts/generate-docs.mjs",
    "generate-strings": "node scripts/generate-strings.mjs",
    "storybook": "storybook dev -p ${PORT:-6006}",
    "build": "vp run pack && storybook build",
    "test": "vp test",
    "check": "vp check ./src",
    "prepare": "vp config"
  },
  "dependencies": {
    "duration-fns": "^3.0.2",
    "lit": "^3.3.3",
    "tabbable": "^6.5.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "baseline-status": "^1.2.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5",
    "vitest-browser-lit": "^1.0.1"
  },
  "packageManager": "npm@11.21.1",
  "customElements": "custom-elements.json"
}
