{
  "name": "use-wc",
  "homepage": "https://usewc.com",
  "bugs": "https://github.com/dang-rabbits/use-wc/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/dang-rabbits/use-wc"
  },
  "license": "MIT",
  "private": false,
  "version": "0.0.0-semantic-release",
  "type": "module",
  "files": [
    "dist",
    "custom-elements.json",
    "vscode.html-custom-data.json",
    "vscode.css-custom-data.json"
  ],
  "customElements": "custom-elements.json",
  "main": "./dist/use-wc.umd.cjs",
  "module": "./dist/use-wc.js",
  "types": "./dist/use-wc.d.ts",
  "exports": {
    ".": {
      "import": "./dist/use-wc.js",
      "require": "./dist/use-wc.umd.cjs"
    },
    "./design-system.css": "./dist/design-system.css",
    "./default-tokens.css": "./dist/default-tokens.css"
  },
  "scripts": {
    "build": "tsc && npm run analyze && vite build",
    "preview": "vite preview",
    "analyze": "custom-elements-manifest analyze",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run build && npm run analyze && storybook build",
    "lint": "eslint ./src"
  },
  "dependencies": {
    "duration-fns": "^3.0.2",
    "lit": "^3.3.1",
    "tabbable": "^6.2.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.3",
    "@eslint/js": "^9.24.0",
    "@storybook/addon-a11y": "^10.2.7",
    "@storybook/addon-docs": "^10.2.7",
    "@storybook/addon-links": "^10.2.7",
    "@storybook/web-components-vite": "^10.2.7",
    "baseline-status": "^1.0.10",
    "custom-element-vs-code-integration": "^1.5.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-storybook": "^10.2.7",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "semantic-release": "^25.0.3",
    "storybook": "^10.2.7",
    "storybook-addon-tag-badges": "^1.4.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.29.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}